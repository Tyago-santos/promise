# PORT: em produção no Render, a plataforma injeta PORT automaticamente, não precisa setar.
PORT=3333
NODE_ENV=development

# Postgres local via docker-compose:
# DATABASE_URL="postgresql://promise:promise@localhost:5433/promise?schema=public"
# DIRECT_URL="postgresql://promise:promise@localhost:5433/promise?schema=public"

# Supabase via pooler: 6543 = transaction mode (app), 5432 = session mode (migrations).
DATABASE_URL="postgresql://postgres.SEU-PROJECT-REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.SEU-PROJECT-REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=7d

# Em produção, use a URL do frontend na Vercel (pode listar várias, separadas por vírgula).
CORS_ORIGIN=http://localhost:3000
# CORS_ORIGIN=https://promise.vercel.app,https://promise-git-main-seu-usuario.vercel.app

SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sua-anon-key
# Ignora RLS. Mantenha apenas no servidor, nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
SUPABASE_STORAGE_BUCKET=photos
